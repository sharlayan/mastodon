- content_for :page_title do
  MiAuth

.form-container.simple_form
  .oauth-prompt
    %h3 MiAuth

    - if @app_name.present?
      %p= t('misskey_compat.authorization.access_request_html', app: content_tag(:strong, @app_name), account: content_tag(:strong, "@#{current_account.username}"))
    - else
      %p= t('misskey_compat.authorization.access_request_unnamed_html', account: content_tag(:strong, "@#{current_account.username}"))

    %p= t('misskey_compat.authorization.permission_notice')

    .actions
      = form_with url: miauth_path(session: @session), method: :post do |form|
        = form.hidden_field :name, value: @app_name
        = form.hidden_field :callback, value: @callback
        = form.hidden_field :permission, value: @permission
        = form.button t('misskey_compat.authorization.approve'), type: :submit, class: 'btn button'
