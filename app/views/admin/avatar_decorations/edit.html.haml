- content_for :page_title do
  = t('admin.avatar_decorations.edit')

- if @decoration.local?
  = simple_form_for [:admin, @decoration] do |f|
    = render 'shared/error_messages', object: @decoration

    .fields-group
      = f.input :name,
                wrapper: :with_label,
                label: t('admin.avatar_decorations.name')

    .fields-group
      = f.input :description,
                wrapper: :with_label,
                label: t('admin.avatar_decorations.description'),
                as: :text,
                input_html: { rows: 3 }

    - if @decoration.image_url.present?
      .fields-group
        %p.hint= t('admin.avatar_decorations.current_image')
        %img.avatar-decoration-preview{ src: @decoration.image_url, alt: @decoration.name }

    .fields-group
      = f.input :category_id,
                wrapper: :with_label,
                label: t('admin.avatar_decorations.category'),
                as: :select,
                collection: AvatarDecorationCategory.alphabetic.map { |c| [c.name, c.id] },
                include_blank: t('admin.avatar_decorations.no_category')

    .fields-group
      .with_label
        = f.label :category_name, t('admin.avatar_decorations.new_category'), class: 'string optional'
        = f.text_field :category_name, class: 'string optional'
        %span.hint= t('admin.avatar_decorations.new_category_hint')

    .fields-group
      = f.input :required_role_id,
                wrapper: :with_label,
                label: t('admin.avatar_decorations.required_role'),
                hint: t('admin.avatar_decorations.required_role_hint'),
                as: :select,
                collection: [[t('admin.avatar_decorations.no_role_required'), nil]] + UserRole.assignable.map { |r| [r.name, r.id] },
                include_blank: false

    .fields-group
      = f.input :image,
                wrapper: :with_label,
                label: t('admin.avatar_decorations.replace_image'),
                hint: t('admin.avatar_decorations.image_hint', size: number_to_human_size(AvatarDecoration::IMAGE_LIMIT)),
                input_html: { accept: AvatarDecoration::IMAGE_MIME_TYPES.join(',') }

    .actions
      = f.button :button, t('generic.save_changes'), type: :submit
      = link_to t('generic.cancel'), admin_avatar_decorations_path, class: 'button button--secondary'
- else
  .simple_form
    - if @decoration.image_url.present?
      .fields-group
        %p.hint= t('admin.avatar_decorations.current_image')
        %img.avatar-decoration-preview{ src: @decoration.image_url, alt: @decoration.name }

    .actions
      = link_to t('admin.avatar_decorations.redownload'), redownload_admin_avatar_decoration_path(@decoration), method: :post, class: 'button button--block'
      = link_to t('generic.cancel'), admin_avatar_decorations_path, class: 'button button--secondary'
