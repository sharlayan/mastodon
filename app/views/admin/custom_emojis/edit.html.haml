- content_for :page_title do
  = t('.title')

= simple_form_for [:admin, @custom_emoji] do |f|
  = render 'shared/error_messages', object: @custom_emoji

  .fields-group
    .label_input
      %label= t('admin.custom_emojis.emoji')
      .custom-emoji-preview
        = custom_emoji_tag(@custom_emoji)
        %samp :#{@custom_emoji.shortcode}:
      %span.hint= t('admin.custom_emojis.shortcode_readonly_hint')

  .fields-group
    = f.input :aliases_raw,
              wrapper: :with_label,
              label: t('admin.custom_emojis.aliases'),
              hint: t('admin.custom_emojis.aliases_hint'),
              input_html: { value: @custom_emoji.aliases&.join(', ') }
  .fields-group
    = f.input :license,
              wrapper: :with_label,
              label: t('admin.custom_emojis.license'),
              hint: t('admin.custom_emojis.license_hint')
  .fields-group
    = f.input :is_sensitive,
              as: :boolean,
              wrapper: :with_label,
              label: t('admin.custom_emojis.is_sensitive'),
              hint: t('admin.custom_emojis.is_sensitive_hint')
  .fields-group
    = f.input :local_only,
              as: :boolean,
              wrapper: :with_label,
              label: t('admin.custom_emojis.local_only'),
              hint: t('admin.custom_emojis.local_only_hint')

  .actions
    = f.button :button,
               t('generic.save_changes'),
               type: :submit
