- content_for :page_title do
  = t('admin.board_announcements.title')

- content_for :heading_actions do
  = link_to t('admin.board_announcements.new.title'), new_admin_board_announcement_path, class: 'button'

- if @announcements.empty?
  .muted-hint.center-text
    = t 'admin.board_announcements.empty'
- else
  .announcements-list
    = render partial: 'board_announcement', collection: @announcements

= paginate @announcements
