- content_for :page_title do
  = t('admin.board_announcements.new.title')

= simple_form_for [:admin, @announcement], html: { novalidate: false, multipart: true } do |form|
  = render 'shared/error_messages', object: @announcement

  = render form

  .actions
    = form.button :button,
                  t('admin.board_announcements.new.create'),
                  type: :submit
