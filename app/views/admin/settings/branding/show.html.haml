- content_for :page_title do
  = t('admin.settings.branding.title')

- content_for :heading do
  %h1= t('admin.settings.title')
  = render partial: 'admin/settings/shared/links'

= simple_form_for @admin_settings, url: admin_settings_branding_path do |f|
  = render 'shared/error_messages', object: @admin_settings

  %p.lead= t('admin.settings.branding.preamble')

  .fields-group
    = f.input :site_title,
              wrapper: :with_label

  .fields-row
    .fields-row__column.fields-row__column-6.fields-group
      = f.input :site_contact_username,
                wrapper: :with_label
    .fields-row__column.fields-row__column-6.fields-group
      = f.input :site_contact_email,
                wrapper: :with_label

  .fields-group
    = f.input :site_short_description,
              as: :text,
              input_html: { rows: 2, maxlength: Form::AdminSettings::DESCRIPTION_LIMIT },
              wrapper: :with_block_label

  .fields-group
    = f.input :theme_color,
              input_html: { type: 'color' },
              wrapper: :with_label

  %h2= t('admin.settings.branding.logos.title')

  .fields-row
    .fields-row__column.fields-row__column-6.fields-group
      = f.input :logo_icon,
                as: :file,
                input_html: { accept: f.object.class::UPLOAD_MIME_TYPES },
                label: t('admin.settings.branding.logos.icon.title'),
                hint: t('admin.settings.branding.logos.icon.hint'),
                wrapper: :with_block_label
    .fields-row__column.fields-row__column-6.fields-group
      - if @admin_settings.logo_icon.persisted?
        = image_tag @admin_settings.logo_icon.file.url, class: 'fields-group__thumbnail', width: 79, height: 79
        = link_to admin_site_upload_path(@admin_settings.logo_icon), data: { method: :delete }, class: 'link-button link-button--destructive' do
          = material_symbol 'delete'
          = t('admin.site_uploads.delete')

  .fields-row
    .fields-row__column.fields-row__column-6.fields-group
      = f.input :logo_wordmark_dark,
                as: :file,
                input_html: { accept: f.object.class::UPLOAD_MIME_TYPES },
                label: t('admin.settings.branding.logos.wordmark_dark.title'),
                hint: t('admin.settings.branding.logos.wordmark_dark.hint'),
                wrapper: :with_block_label
    .fields-row__column.fields-row__column-6.fields-group
      - if @admin_settings.logo_wordmark_dark.persisted?
        = image_tag @admin_settings.logo_wordmark_dark.file.url, class: 'fields-group__thumbnail', width: 261, height: 66
        = link_to admin_site_upload_path(@admin_settings.logo_wordmark_dark), data: { method: :delete }, class: 'link-button link-button--destructive' do
          = material_symbol 'delete'
          = t('admin.site_uploads.delete')

  .fields-row
    .fields-row__column.fields-row__column-6.fields-group
      = f.input :logo_wordmark_light,
                as: :file,
                input_html: { accept: f.object.class::UPLOAD_MIME_TYPES },
                label: t('admin.settings.branding.logos.wordmark_light.title'),
                hint: t('admin.settings.branding.logos.wordmark_light.hint'),
                wrapper: :with_block_label
    .fields-row__column.fields-row__column-6.fields-group
      - if @admin_settings.logo_wordmark_light.persisted?
        = image_tag @admin_settings.logo_wordmark_light.file.url, class: 'fields-group__thumbnail', width: 261, height: 66
        = link_to admin_site_upload_path(@admin_settings.logo_wordmark_light), data: { method: :delete }, class: 'link-button link-button--destructive' do
          = material_symbol 'delete'
          = t('admin.site_uploads.delete')

  .fields-row
    .fields-row__column.fields-row__column-6.fields-group
      = f.input :thumbnail,
                as: :file,
                wrapper: :with_block_label
      - if @admin_settings.thumbnail.persisted?
        = f.input :thumbnail_description,
                  as: :text,
                  input_html: { rows: 2, maxlength: Form::AdminSettings::DESCRIPTION_LIMIT },
                  wrapper: :with_block_label
    .fields-row__column.fields-row__column-6.fields-group
      - if @admin_settings.thumbnail.persisted?
        = image_tag @admin_settings.thumbnail.file.url(:'@1x'), class: 'fields-group__thumbnail'
        = link_to admin_site_upload_path(@admin_settings.thumbnail), data: { method: :delete }, class: 'link-button link-button--destructive' do
          = material_symbol 'delete'
          = t('admin.site_uploads.delete')

  .fields-row
    .fields-row__column.fields-row__column-6.fields-group
      = f.input :favicon,
                as: :file,
                input_html: { accept: f.object.class::UPLOAD_MIME_TYPES },
                wrapper: :with_block_label

    .fields-row__column.fields-row__column-6.fields-group
      - if @admin_settings.favicon.persisted?
        = image_tag @admin_settings.favicon.file.url('48'), class: 'fields-group__thumbnail'
        = link_to admin_site_upload_path(@admin_settings.favicon), data: { method: :delete }, class: 'link-button link-button--destructive' do
          = material_symbol 'delete'
          = t('admin.site_uploads.delete')

  .fields-row
    .fields-row__column.fields-row__column-6.fields-group
      = f.input :app_icon,
                as: :file,
                input_html: { accept: f.object.class::UPLOAD_MIME_TYPES },
                wrapper: :with_block_label

    .fields-row__column.fields-row__column-6.fields-group
      - if @admin_settings.app_icon.persisted?
        = image_tag @admin_settings.app_icon.file.url('48'), class: 'fields-group__thumbnail'
        = link_to admin_site_upload_path(@admin_settings.app_icon), data: { method: :delete }, class: 'link-button link-button--destructive' do
          = material_symbol 'delete'
          = t('admin.site_uploads.delete')

  .fields-row
    = f.input :landing_page,
              as: :radio_buttons,
              collection: f.object.class::LANDING_PAGE,
              include_blank: false,
              label_method: ->(page) { safe_join([I18n.t("admin.settings.landing_page.values.#{page}"), content_tag(:span, I18n.t("admin.settings.landing_page.hints.#{page}_html"), class: 'hint')]) },
              wrapper: :with_block_label

  .actions
    = f.button :button, t('generic.save_changes'), type: :submit
