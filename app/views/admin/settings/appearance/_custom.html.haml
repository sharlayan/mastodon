  %h2= t('admin.settings.community_mode_override.title')

  %p.lead= t('admin.settings.community_mode_override.preamble')

  .fields-group
    = f.input :force_avatar_decorations,
              as: :boolean,
              wrapper: :with_label,
              label: t('admin.settings.community_mode_override.force_avatar_decorations'),
