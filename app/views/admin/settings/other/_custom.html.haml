%h2= t('admin.settings.rate_limit_bypass.title')

.fields-group
  = f.input :rate_limit_bypass_enabled,
            as: :boolean,
            wrapper: :with_label,
            label: t('admin.settings.rate_limit_bypass.enabled'),
            hint: t('admin.settings.rate_limit_bypass.enabled_hint'),
            sharlayan_only: true

%h2= t('admin.settings.extensions.title')

.fields-group
  = f.input :circles_enabled,
            as: :boolean,
            wrapper: :with_label,
            label: t('admin.settings.circles.enabled'),
            hint: t('admin.settings.circles.enabled_hint'),
            sharlayan_only: true

.fields-group
  = f.input :clips_enabled,
            as: :boolean,
            wrapper: :with_label,
            label: t('admin.settings.clips.enabled'),
            hint: t('admin.settings.clips.enabled_hint'),
            sharlayan_only: true

.fields-group
  = f.input :pages_enabled,
            as: :boolean,
            wrapper: :with_label,
            label: t('admin.settings.pages.enabled'),
            hint: t('admin.settings.pages.enabled_hint'),
            sharlayan_only: true

.fields-group
  = f.input :antenna_enabled,
            as: :boolean,
            wrapper: :with_label,
            label: t('admin.settings.antenna.enabled'),
            hint: t('admin.settings.antenna.enabled_hint'),
            sharlayan_only: true

.fields-group
  = f.input :drive_enabled,
            as: :boolean,
            wrapper: :with_label,
            label: t('admin.settings.drive.enabled'),
            hint: t('admin.settings.drive.enabled_hint'),
            sharlayan_only: true

.fields-group
  = f.input :drive_quota,
            as: :integer,
            wrapper: :with_label,
            label: t('admin.settings.drive.quota'),
            hint: t('admin.settings.drive.quota_hint'),
            input_html: { min: 0 },
            sharlayan_only: true

.fields-group
  = f.input :drive_max_file_size,
