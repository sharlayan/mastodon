%h2= t('admin.settings.rate_limit_bypass.title')

.fields-group
  = f.input :rate_limit_bypass_enabled,
            as: :boolean,
            wrapper: :with_label,
            label: t('admin.settings.rate_limit_bypass.enabled'),
            hint: t('admin.settings.rate_limit_bypass.enabled_hint'),
            sharlayan_only: true

%h2= t('admin.settings.extensions.title')

.fields-group
  = f.input :circles_enabled,
            as: :boolean,
            wrapper: :with_label,
            label: t('admin.settings.circles.enabled'),
            hint: t('admin.settings.circles.enabled_hint'),
            sharlayan_only: true

.fields-group
  = f.input :clips_enabled,
            as: :boolean,
            wrapper: :with_label,
            label: t('admin.settings.clips.enabled'),
            hint: t('admin.settings.clips.enabled_hint'),
            sharlayan_only: true

.fields-group
  = f.input :antenna_enabled,
            as: :boolean,
            wrapper: :with_label,
            label: t('admin.settings.antenna.enabled'),
            hint: t('admin.settings.antenna.enabled_hint'),
            disabled: roleplay_mode?,
            sharlayan_only: true

%h2= t('admin.settings.special_features.title')

.fields-group
  = f.input :instance_metadata_enabled,
            as: :boolean,
            wrapper: :with_label,
            label: t('admin.settings.instance_metadata.enabled'),
            hint: t('admin.settings.instance_metadata.enabled_hint'),
            sharlayan_only: true

.fields-group
  = f.input :auto_quote_from_url,
            as: :boolean,
            wrapper: :with_label,
            label: t('admin.settings.auto_quote_from_url.enabled'),
            hint: t('admin.settings.auto_quote_from_url.enabled_hint'),
            sharlayan_only: true

- if roleplay_mode?
  %h2= t('admin.settings.community_mode.title')

  .fields-group
    = f.input :soft_hide_deletion,
              as: :boolean,
              wrapper: :with_label,
              label: t('admin.settings.soft_hide_deletion.enabled'),
              hint: t('admin.settings.soft_hide_deletion.enabled_hint'),
              sharlayan_only: true
