%h2= t('admin.settings.rate_limit_bypass.title')

.fields-group
  = f.input :rate_limit_bypass_enabled,
            as: :boolean,
            wrapper: :with_label,
            label: t('admin.settings.rate_limit_bypass.enabled'),
            hint: t('admin.settings.rate_limit_bypass.enabled_hint'),
            sharlayan_only: true

