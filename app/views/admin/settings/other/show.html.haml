- content_for :page_title do
  = t('admin.settings.other.title')

- content_for :heading do
  %h2= t('admin.settings.title')
  = render partial: 'admin/settings/shared/links'

= simple_form_for @admin_settings, url: admin_settings_other_path, html: { method: :patch } do |f|
  = render 'shared/error_messages', object: @admin_settings

  %p.lead= t('admin.settings.other.preamble')

  .fields-group
    = f.input :hide_followers_count, as: :boolean, wrapper: :with_label, label: t('admin.settings.hide_followers_count.title'), hint: t('admin.settings.hide_followers_count.desc_html'), glitch_only: true

  .fields-group
    = f.input :show_reblogs_in_public_timelines, as: :boolean, wrapper: :with_label, label: t('admin.settings.show_reblogs_in_public_timelines.title'), hint: t('admin.settings.show_reblogs_in_public_timelines.desc_html'), glitch_only: true

  .fields-group
    = f.input :show_replies_in_public_timelines, as: :boolean, wrapper: :with_label, label: t('admin.settings.show_replies_in_public_timelines.title'), hint: t('admin.settings.show_replies_in_public_timelines.desc_html'), glitch_only: true

  .fields-group
    = f.input :outgoing_spoilers, wrapper: :with_label, label: t('admin.settings.outgoing_spoilers.title'), hint: t('admin.settings.outgoing_spoilers.desc_html'), glitch_only: true

  %h2= t('admin.settings.mfm.title')

  .fields-group
    = f.input :mfm_enabled, as: :boolean, wrapper: :with_label, label: t('admin.settings.mfm_enabled.title'), hint: t('admin.settings.mfm_enabled.desc_html')

  .fields-group
    = f.input :mfm_allow_composition, as: :boolean, wrapper: :with_label, label: t('admin.settings.mfm_allow_composition.title'), hint: t('admin.settings.mfm_allow_composition.desc_html')

  %h2= t('admin.settings.avatar_decorations.title')

  .fields-group
    = f.input :avatar_decorations_enabled,
              as: :boolean,
              wrapper: :with_label,
              label: t('admin.settings.avatar_decorations.enabled'),
              hint: t('admin.settings.avatar_decorations.enabled_hint')

  .fields-group
    = f.input :avatar_decorations_federation_enabled,
              as: :boolean,
              wrapper: :with_label,
              label: t('admin.settings.avatar_decorations.federation_enabled'),
              hint: t('admin.settings.avatar_decorations.federation_enabled_hint')

  .fields-group
    = f.input :avatar_decorations_local_only_view,
              as: :boolean,
              wrapper: :with_label,
              label: t('admin.settings.avatar_decorations.local_only_view'),
              hint: t('admin.settings.avatar_decorations.local_only_view_hint')

  .fields-group
    = f.input :avatar_decorations_max_count,
              as: :integer,
              wrapper: :with_label,
              label: t('admin.settings.avatar_decorations.max_count'),
              hint: t('admin.settings.avatar_decorations.max_count_hint'),
              input_html: { min: 0, max: 16 }

  %h2= t('admin.settings.rate_limit_bypass.title')

  .fields-group
    = f.input :rate_limit_bypass_enabled,
              as: :boolean,
              wrapper: :with_label,
              label: t('admin.settings.rate_limit_bypass.enabled'),
              hint: t('admin.settings.rate_limit_bypass.enabled_hint')

  .actions
    = f.button :button, t('generic.save_changes'), type: :submit
