%h2= t('admin.settings.status_character_limit.title')

.fields-group
  = f.input :status_character_limit,
            as: :integer,
            wrapper: :with_label,
            label: t('admin.settings.status_character_limit.label'),
            hint: t('admin.settings.status_character_limit.hint'),
            input_html: { min: 1 },
            sharlayan_only: true

%h2= t('admin.settings.rate_limit_bypass.title')

.fields-group
  = f.input :rate_limit_bypass_enabled,
            as: :boolean,
            wrapper: :with_label,
            label: t('admin.settings.rate_limit_bypass.enabled'),
            hint: t('admin.settings.rate_limit_bypass.enabled_hint'),
            sharlayan_only: true

- if roleplay_mode?
  %h2= t('admin.settings.community_mode.title')

  .fields-group
    = f.input :soft_hide_deletion,
              as: :boolean,
              wrapper: :with_label,
              label: t('admin.settings.community_mode.soft_hide_deletion'),
              hint: t('admin.settings.community_mode.soft_hide_deletion_hint'),
              sharlayan_only: true

%h2= t('admin.settings.extensions.title')

.fields-group
  = f.input :circles_enabled,
            as: :boolean,
            wrapper: :with_label,
            label: t('admin.settings.circles.enabled'),
            hint: t('admin.settings.circles.enabled_hint'),
            sharlayan_only: true

.fields-group
  = f.input :clips_enabled,
            as: :boolean,
            wrapper: :with_label,
            label: t('admin.settings.clips.enabled'),
            hint: t('admin.settings.clips.enabled_hint'),
            sharlayan_only: true

.fields-group
  = f.input :pages_enabled,
            as: :boolean,
            wrapper: :with_label,
            label: t('admin.settings.pages.enabled'),
            hint: t('admin.settings.pages.enabled_hint'),
            sharlayan_only: true

.fields-group
  = f.input :pages_drive_only,
            as: :boolean,
            wrapper: :with_label,
            label: t('admin.settings.pages.drive_only'),
            hint: t('admin.settings.pages.drive_only_hint'),
            sharlayan_only: true

.fields-group
  = f.input :antenna_enabled,
            as: :boolean,
            wrapper: :with_label,
            label: t('admin.settings.antenna.enabled'),
            hint: t('admin.settings.antenna.enabled_hint'),
            disabled: roleplay_mode?,
            sharlayan_only: true

.fields-group
  = f.input :drive_enabled,
            as: :boolean,
            wrapper: :with_label,
            label: t('admin.settings.drive.enabled'),
            hint: t('admin.settings.drive.enabled_hint'),
            sharlayan_only: true

.fields-group
  = f.input :drive_quota,
            as: :integer,
            wrapper: :with_label,
            label: t('admin.settings.drive.quota'),
            hint: t('admin.settings.drive.quota_hint'),
            input_html: { min: 0 },
            sharlayan_only: true

.fields-group
  = f.input :drive_max_file_size,
            as: :integer,
            wrapper: :with_label,
            label: t('admin.settings.drive.max_file_size'),
            hint: t('admin.settings.drive.max_file_size_hint'),
            input_html: { min: 1 },
            sharlayan_only: true

.fields-group
  = f.input :drive_allowed_extensions,
            wrapper: :with_label,
            label: t('admin.settings.drive.allowed_extensions'),
            hint: t('admin.settings.drive.allowed_extensions_hint', extensions: DriveFile::FORBIDDEN_EXTENSIONS.join(', ')),
            sharlayan_only: true

%h2= t('admin.settings.special_features.title')

.fields-group
  = f.input :instance_metadata_enabled,
            as: :boolean,
            wrapper: :with_label,
            label: t('admin.settings.instance_metadata.enabled'),
            hint: t('admin.settings.instance_metadata.enabled_hint'),
            sharlayan_only: true
  = f.input :federation_request_statistics_enabled,
            as: :boolean,
            wrapper: :with_label,
            label: t('admin.settings.federation_request_statistics.enabled'),
            hint: roleplay_mode? ? t('admin.settings.federation_request_statistics.roleplay_hint') : t('admin.settings.federation_request_statistics.enabled_hint'),
            disabled: roleplay_mode?,
            sharlayan_only: true
  = f.input :federation_instance_edges_enabled,
            as: :boolean,
            wrapper: :with_label,
            label: t('admin.settings.federation_instance_edges.enabled'),
            hint: roleplay_mode? ? t('admin.settings.federation_instance_edges.roleplay_hint') : t('admin.settings.federation_instance_edges.enabled_hint'),
            disabled: roleplay_mode?,
            sharlayan_only: true

.fields-group
  = f.input :auto_quote_from_url,
            as: :boolean,
            wrapper: :with_label,
            label: t('admin.settings.auto_quote_from_url.enabled'),
            hint: t('admin.settings.auto_quote_from_url.enabled_hint'),
            sharlayan_only: true
