.applications-list__item
  %strong.announcements-list__item__title
    = relay.display_name
    %span.information-badge{ class: relay_badge_class(relay) }
      - if relay.accepted?
        = material_symbol('check')
        = t 'admin.relays.enabled'
      - elsif relay.paused?
        = material_symbol('pause')
        = t 'admin.relays.paused'
      - elsif relay.pending?
        = material_symbol('hourglass')
        = t 'admin.relays.pending'
      - else
        = material_symbol('close')
        = t 'admin.relays.disabled'
  .announcements-list__item__action-bar
    .announcements-list__item__meta
      %samp= relay.uri
      ·
      - if relay.bidirectional?
        = t 'admin.relays.bidirectional'
      - else
        = t 'admin.relays.broadcast'
      ·
      - if relay.requires_opt_in?
        = t 'admin.relays.opt_in'
      - else
        = t 'admin.relays.opt_out'
      ·
      - if relay.suppress_public_timeline_stream?
        = t 'admin.relays.public_timeline_stream_suppressed'
      - else
        = t 'admin.relays.public_timeline_stream_enabled'
    .announcements-list__item__actions
      - if relay.accepted?
        = table_link_to 'pause', t('admin.relays.pause'), pause_admin_relay_path(relay), method: :post, data: { confirm: t('admin.accounts.are_you_sure') }
        = table_link_to 'power_off', t('admin.relays.disable'), disable_admin_relay_path(relay), method: :post, data: { confirm: t('admin.accounts.are_you_sure') }
      - elsif relay.paused?
        = table_link_to 'play_arrow', t('admin.relays.resume'), resume_admin_relay_path(relay), method: :post
        = table_link_to 'power_off', t('admin.relays.disable'), disable_admin_relay_path(relay), method: :post, data: { confirm: t('admin.accounts.are_you_sure') }
      - elsif !relay.pending?
        = table_link_to 'power_off', t('admin.relays.enable'), enable_admin_relay_path(relay), method: :post, data: { confirm: t('admin.accounts.are_you_sure') }

      = table_link_to relay.suppress_public_timeline_stream? ? 'play_arrow' : 'pause',
                      relay.suppress_public_timeline_stream? ? t('admin.relays.resume_public_timeline_stream') : t('admin.relays.suppress_public_timeline_stream'),
                      toggle_public_timeline_stream_admin_relay_path(relay), method: :post
      = table_link_to 'close', t('admin.relays.delete'), admin_relay_path(relay), method: :delete, data: { confirm: t('admin.accounts.are_you_sure') }
