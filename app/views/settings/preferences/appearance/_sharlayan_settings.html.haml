%h2= t 'appearance.customized'

.fields-group
  = ff.input :'web.custom_emoji_size',
             wrapper: :with_label,
             hint: t('simple_form.hints.defaults.setting_custom_emoji_size'),
             label: t('simple_form.labels.defaults.setting_custom_emoji_size'),
             sharlayan_only: true
  = ff.input :'web.reaction_custom_emoji_size',
             wrapper: :with_label,
             hint: t('simple_form.hints.defaults.setting_reaction_custom_emoji_size'),
             label: t('simple_form.labels.defaults.setting_reaction_custom_emoji_size'),
             sharlayan_only: true

.fields-group.fields-row__column.fields-row__column-6
  = ff.input :visible_reactions,
             wrapper: :with_label,
             label: I18n.t('simple_form.labels.defaults.setting_visible_reactions'),
             input_html: { type: 'number', min: '0', data: { default: '6' } },
             hint: false,
             sharlayan_only: true

.fields-group
  = ff.input :content_font_size,
             collection: %w(medium large x_large xx_large),
             include_blank: false,
             label_method: ->(size) { t("content_font_sizes.#{size}") },
             wrapper: :with_label,
             hint: t('simple_form.hints.defaults.setting_content_font_size'),
             label: t('simple_form.labels.defaults.setting_content_font_size'),
             sharlayan_only: true

%h2= t 'appearance.misskey_flavour'

.fields-group
  = ff.input :'web.show_instance_info',
             wrapper: :with_label,
             hint: t('simple_form.hints.defaults.setting_show_instance_info'),
             label: t('simple_form.labels.defaults.setting_show_instance_info'),
             sharlayan_only: true
  - if Setting.mfm_enabled
    = ff.input :'web.mfm_enabled',
               wrapper: :with_label,
               hint: t('simple_form.hints.defaults.setting_mfm_enabled'),
               label: t('simple_form.labels.defaults.setting_mfm_enabled'),
               sharlayan_only: true
    = ff.input :'web.mfm_animations',
               wrapper: :with_label,
               hint: t('simple_form.hints.defaults.setting_mfm_animations'),
               label: t('simple_form.labels.defaults.setting_mfm_animations'),
               sharlayan_only: true

.fields-group
  = ff.input :'web.mfm_fold_mode',
             collection: %w(show sensitive all),
             include_blank: false,
             label_method: ->(mode) { t("simple_form.labels.defaults.setting_mfm_fold_mode_#{mode}") },
             wrapper: :with_label,
             hint: t('simple_form.hints.defaults.setting_mfm_fold_mode'),
             label: t('simple_form.labels.defaults.setting_mfm_fold_mode'),
             sharlayan_only: true

- if Setting.avatar_decorations_enabled
  %h2= t 'settings.avatar_decorations'
  .fields-group
    = ff.input :'avatar_decorations.show',
               wrapper: :with_label,
               label: t('simple_form.labels.defaults.setting_show_avatar_decorations'),
               hint: t('simple_form.hints.defaults.setting_show_avatar_decorations'),
               sharlayan_only: true
    - if Setting.avatar_decorations_federation_enabled
      = ff.input :'avatar_decorations.show_federated',
                 wrapper: :with_label,
                 label: t('simple_form.labels.defaults.setting_show_federated_avatar_decorations'),
                 hint: t('simple_form.hints.defaults.setting_show_federated_avatar_decorations'),
                 sharlayan_only: true
    = ff.input :'avatar_decorations.shape',
               as: :radio_buttons,
               collection: %w(none round square),
               include_blank: false,
               label_method: ->(shape) { t("simple_form.labels.defaults.setting_avatar_decoration_shape_#{shape}") },
               wrapper: :with_label,
               label: t('simple_form.labels.defaults.setting_avatar_decoration_shape'),
               hint: t('simple_form.hints.defaults.setting_avatar_decoration_shape'),
               sharlayan_only: true
