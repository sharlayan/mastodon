%h2= t 'appearance.customized'

.fields-group
  = ff.input :'web.custom_emoji_size',
             wrapper: :with_label,
             hint: t('simple_form.hints.defaults.setting_custom_emoji_size'),
             label: t('simple_form.labels.defaults.setting_custom_emoji_size'),
             sharlayan_only: true
  = ff.input :'web.reaction_custom_emoji_size',
             wrapper: :with_label,
             hint: t('simple_form.hints.defaults.setting_reaction_custom_emoji_size'),
             label: t('simple_form.labels.defaults.setting_reaction_custom_emoji_size'),
             sharlayan_only: true

.fields-group.fields-row__column.fields-row__column-6
  = ff.input :visible_reactions,
             wrapper: :with_label,
             label: I18n.t('simple_form.labels.defaults.setting_visible_reactions'),
             input_html: { type: 'number', min: '0', data: { default: '6' } },
             hint: false,
             sharlayan_only: true

%h2= t 'pages.settings.heading'

.fields-group
  = ff.input :'web.pages_view',
             as: :radio_buttons,
             collection: %w(list blog),
             include_blank: false,
             label_method: ->(view) { t("simple_form.labels.defaults.setting_pages_view_#{view}") },
             wrapper: :with_label,
             hint: t('simple_form.hints.defaults.setting_pages_view'),
             label: t('simple_form.labels.defaults.setting_pages_view'),
             sharlayan_only: true
  = ff.input :'web.pages_blog_list_position',
             as: :radio_buttons,
             collection: %w(left right),
             include_blank: false,
             label_method: ->(position) { t("simple_form.labels.defaults.setting_pages_blog_list_position_#{position}") },
             wrapper: :with_label,
             hint: t('simple_form.hints.defaults.setting_pages_blog_list_position'),
             label: t('simple_form.labels.defaults.setting_pages_blog_list_position'),
             sharlayan_only: true
  = ff.input :'web.ignore_others_pages_view',
             wrapper: :with_label,
             hint: t('simple_form.hints.defaults.setting_ignore_others_pages_view'),
             label: t('simple_form.labels.defaults.setting_ignore_others_pages_view'),
             sharlayan_only: true

%h2= t 'appearance.misskey_flavour'

- if Setting.mfm_enabled
  .fields-group
    - mfm_forced = roleplay_mode? && Setting.force_mfm_enabled
    = ff.input :'web.mfm_enabled',
               wrapper: :with_label,
               hint: mfm_forced ? t('appearance.community_mode_forced_hint') : t('simple_form.hints.defaults.setting_mfm_enabled'),
               label: t('simple_form.labels.defaults.setting_mfm_enabled'),
               sharlayan_only: true
    = ff.input :'web.mfm_animations',
               wrapper: :with_label,
               hint: t('simple_form.hints.defaults.setting_mfm_animations'),
               label: t('simple_form.labels.defaults.setting_mfm_animations'),
               sharlayan_only: true

.fields-group
  = ff.input :'web.mfm_fold_mode',
             collection: %w(show sensitive all),
             include_blank: false,
             label_method: ->(mode) { t("simple_form.labels.defaults.setting_mfm_fold_mode_#{mode}") },
             wrapper: :with_label,
             hint: t('simple_form.hints.defaults.setting_mfm_fold_mode'),
             label: t('simple_form.labels.defaults.setting_mfm_fold_mode'),
             sharlayan_only: true

- if Setting.avatar_decorations_enabled
  - avatar_decorations_forced = roleplay_mode? && Setting.force_avatar_decorations
  %h2= t 'settings.avatar_decorations'
  .fields-group
    = ff.input :'avatar_decorations.show',
               wrapper: :with_label,
               label: t('simple_form.labels.defaults.setting_show_avatar_decorations'),
               hint: avatar_decorations_forced ? t('appearance.community_mode_forced_hint') : t('simple_form.hints.defaults.setting_show_avatar_decorations'),
               sharlayan_only: true
    - if Setting.avatar_decorations_federation_enabled && !roleplay_mode?
      = ff.input :'avatar_decorations.show_federated',
                 wrapper: :with_label,
                 label: t('simple_form.labels.defaults.setting_show_federated_avatar_decorations'),
                 hint: t('simple_form.hints.defaults.setting_show_federated_avatar_decorations'),
                 sharlayan_only: true
    - round_avatar_forced = roleplay_mode? && Setting.force_round_avatar
    = ff.input :'avatar_decorations.shape',
               as: :radio_buttons,
               collection: %w(none round square),
               include_blank: false,
               label_method: ->(shape) { t("simple_form.labels.defaults.setting_avatar_decoration_shape_#{shape}") },
               wrapper: :with_label,
               label: t('simple_form.labels.defaults.setting_avatar_decoration_shape'),
               hint: round_avatar_forced ? t('appearance.community_mode_forced_hint') : t('simple_form.hints.defaults.setting_avatar_decoration_shape'),
               sharlayan_only: true

- if Setting.cat_enabled
  %h2= t 'settings.cat'
  .fields-group
    = ff.input :'cat.show',
               wrapper: :with_label,
               label: t('simple_form.labels.defaults.setting_show_cat'),
               hint: t('simple_form.hints.defaults.setting_show_cat'),
               sharlayan_only: true
    - if Setting.cat_federation_enabled
      = ff.input :'cat.show_federated',
                 wrapper: :with_label,
                 label: t('simple_form.labels.defaults.setting_show_federated_cat'),
                 hint: t('simple_form.hints.defaults.setting_show_federated_cat'),
                 sharlayan_only: true
