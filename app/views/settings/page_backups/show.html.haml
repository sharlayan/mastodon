- content_for :page_title do
  = t('page_backups.title')

%p.hint= t('page_backups.description')

.actions
  = link_to t('page_backups.download'), settings_page_backup_path, method: :post, class: 'button'

%hr.spacer/

= simple_form_for :page_backup, url: settings_page_backup_path, method: :put do |f|
  .fields-group
    = f.input :data, as: :file, required: true, accept: 'application/zip,.zip', wrapper: :with_block_label
  .fields-group
    = f.input :mode, as: :radio_buttons, collection: [['merge', t('page_backups.merge')], ['overwrite', t('page_backups.overwrite')]], label_method: :last, value_method: :first, wrapper: :with_block_label
  .actions
    = f.button :button, t('page_backups.upload'), type: :submit
