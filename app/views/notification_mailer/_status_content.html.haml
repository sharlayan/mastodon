.auto-dir
  - if status.spoiler_text?
    %p.email-status-spoiler
      = status.spoiler_text

  .email-status-prose
    = status_content_format(status)

  - if status.ordered_media_attachments.size.positive?
    %p.email-status-media
      - status.ordered_media_attachments.each do |a|
        - if a.image? && !a.needs_redownload?
          %img{ src: full_media_attachment_url(a), alt: a.description }
        - elsif status.local?
          = link_to full_media_attachment_url(a), full_media_attachment_url(a)
        - else
          = link_to a.remote_url, a.remote_url
